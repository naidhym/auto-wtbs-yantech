# Copy this file to .env and fill only the values you need.
# Never commit .env, Telegram session data, database files, or logs.

NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
LOGIN_TIMEOUT_MS=300000

# Dedicated Auto WTB Bot storage
DATABASE_PATH=./data/auto-wtb.sqlite
SESSION_DIRECTORY=./data/sessions
LOG_DIRECTORY=./logs

# Owner-only Admin Bot control panel. Configure each userbot's Monitoring Bot target from Account → Auto Reply Settings.
ADMIN_BOT_ENABLED=false
ADMIN_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# GramJS application credentials used by every isolated account client.
# They remain in .env only and are never persisted to SQLite or logs.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
